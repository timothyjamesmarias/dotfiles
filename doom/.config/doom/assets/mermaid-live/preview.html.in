<meta charset="utf-8">
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #1e1e1e; }
  #viewport { position: fixed; inset: 0; overflow: hidden; cursor: grab; }
  #viewport.panning { cursor: grabbing; }
  #canvas { transform-origin: 0 0; width: 100%; height: 100%;
            display: flex; align-items: center; justify-content: center; }
  #error-badge { position: fixed; top: 8px; right: 8px; max-width: 60%;
                 padding: 4px 10px; border-radius: 10px; font: 12px monospace;
                 background: rgba(200, 60, 60, 0.85); color: #fff;
                 white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #error-badge[hidden] { display: none; }
</style>
<div id="viewport"><div id="canvas"><div id="diagram"></div></div></div>
<div id="error-badge" hidden></div>
<script><!--MERMAID_JS--></script>
<script>
  const viewport = document.getElementById('viewport');
  const canvas = document.getElementById('canvas');
  const diagram = document.getElementById('diagram');
  const errorBadge = document.getElementById('error-badge');

  let lastSource = null;
  let theme = 'dark';
  let scale = 1, tx = 0, ty = 0;

  function applyTransform() {
    canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
  }

  function initTheme(newTheme, bg) {
    theme = newTheme;
    document.body.style.background = bg;
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: theme });
    if (lastSource !== null) {
      const src = lastSource;
      lastSource = null;
      renderSource(src);
    }
  }

  async function renderSource(src) {
    if (src === lastSource) { errorBadge.hidden = true; return; }
    const id = 'm' + Date.now();
    try {
      const { svg } = await mermaid.render(id, src);
      diagram.innerHTML = svg;
      const el = diagram.querySelector('svg');
      if (el) { el.style.maxWidth = 'none'; }
      lastSource = src;
      errorBadge.hidden = true;
    } catch (e) {
      // mermaid leaves an error element in <body> on parse failure
      document.getElementById(id)?.remove();
      document.getElementById('d' + id)?.remove();
      errorBadge.textContent = String(e.message || e).split('\n')[0];
      errorBadge.hidden = false;
    }
  }

  function renderMermaid(b64) {
    const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    renderSource(new TextDecoder('utf-8').decode(bytes));
  }

  viewport.addEventListener('wheel', e => {
    e.preventDefault();
    const factor = Math.exp(-e.deltaY * 0.002);
    const newScale = Math.min(8, Math.max(0.2, scale * factor));
    // zoom around the cursor point
    tx = e.clientX - (e.clientX - tx) * (newScale / scale);
    ty = e.clientY - (e.clientY - ty) * (newScale / scale);
    scale = newScale;
    applyTransform();
  }, { passive: false });

  let panning = false, px = 0, py = 0;
  viewport.addEventListener('pointerdown', e => {
    panning = true; px = e.clientX; py = e.clientY;
    viewport.classList.add('panning');
    viewport.setPointerCapture(e.pointerId);
  });
  viewport.addEventListener('pointermove', e => {
    if (!panning) return;
    tx += e.clientX - px; ty += e.clientY - py;
    px = e.clientX; py = e.clientY;
    applyTransform();
  });
  viewport.addEventListener('pointerup', e => {
    panning = false;
    viewport.classList.remove('panning');
    viewport.releasePointerCapture(e.pointerId);
  });
  viewport.addEventListener('dblclick', () => {
    scale = 1; tx = 0; ty = 0;
    applyTransform();
  });

  mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: theme });
  window.__mermaidReady = true;
  // Emacs polls xwidget-webkit-title for readiness: execute-script
  // callbacks don't fire reliably on macOS NS builds.
  document.title = 'mermaid-ready';
</script>
